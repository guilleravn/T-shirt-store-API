# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tshirt_store?schema=public"

# App
PORT=3000
NODE_ENV=development

# Redis (docker-compose.yml)
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="replace-with-a-long-random-string-in-every-environment"
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Brevo (transactional email)
BREVO_API_KEY="replace-with-your-brevo-api-key"
EMAIL_FROM_ADDRESS="no-reply@example.com"
EMAIL_FROM_NAME="T-Shirt Store"
