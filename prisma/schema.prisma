// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum UserRole {
  MANAGER
  CLIENT
  DELIVERY

  @@map("user_role")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name") @db.VarChar(80)
  lastName     String   @map("last_name") @db.VarChar(80)
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  cart                Cart?
  productLikes        ProductLike[]
  ordersAsCustomer    Order[]              @relation("OrdersAsCustomer")
  ordersAsDelivery    Order[]              @relation("OrdersAsDelivery")
  orderStatusChanges  OrderStatusHistory[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  productCategories ProductCategory[]

  @@map("categories")
}

model Product {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(160)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  productCategories ProductCategory[]
  variants          ProductVariant[]
  images            ProductImage[]
  likes             ProductLike[]

  @@index([isActive, deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  s3Key     String   @map("s3_key") @db.VarChar(512)
  altText   String?  @map("alt_text") @db.VarChar(200)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Color {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(50)
  hexCode   String   @map("hex_code") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  variants ProductVariant[]

  @@map("colors")
}

model Size {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(20)
  position  Int      @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  variants ProductVariant[]

  @@map("sizes")
}

model ProductVariant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  colorId    String    @map("color_id") @db.Uuid
  sizeId     String    @map("size_id") @db.Uuid
  sku        String    @unique @db.VarChar(64)
  priceCents Int       @map("price_cents")
  stock      Int       @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Non-unique on purpose: a soft-deleted row must not permanently block re-creating the same
  // combo later. Real uniqueness is the partial index in T-Shirt-constraints.sql
  // (product_variant_combo_unique, WHERE deleted_at IS NULL).
  @@index([productId, colorId, sizeId])
  @@map("product_variants")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

model ProductLike {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([userId, productId])
  @@index([productId])
  @@map("product_likes")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

model PromoCode {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique @db.VarChar(40)
  discountType     DiscountType @map("discount_type")
  discountValue    Int          @map("discount_value")
  minPurchaseCents Int?         @map("min_purchase_cents")
  usageLimit       Int?         @map("usage_limit")
  expiresAt        DateTime?    @map("expires_at") @db.Timestamptz
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  deliveryPersonId String?     @map("delivery_person_id") @db.Uuid
  status           OrderStatus @default(PENDING)
  subtotalCents    Int         @map("subtotal_cents")
  discountCents    Int         @default(0) @map("discount_cents")
  totalCents       Int         @map("total_cents")
  currency         String      @default("USD") @db.Char(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User                 @relation("OrdersAsCustomer", fields: [userId], references: [id], onDelete: Restrict)
  deliveryPerson  User?                @relation("OrdersAsDelivery", fields: [deliveryPersonId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  promoRedemption PromoRedemption?
  payments        Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([deliveryPersonId, status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  unitPriceCents   Int      @map("unit_price_cents")
  productName      String   @map("product_name") @db.VarChar(160)
  variantLabel     String   @map("variant_label") @db.VarChar(120)
  // R8: false when the webhook's conditional UPDATE found insufficient stock for this line
  // (oversold — recorded only as a free-text order_status_history note, never here) and true
  // when it actually decremented. Without this, cancelling a PAID order can't tell which lines
  // to restore stock for and which never had any taken.
  stockDecremented Boolean  @default(false) @map("stock_decremented")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  status          OrderStatus
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  note            String?     @db.VarChar(255)
  createdAt       DateTime    @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model PromoRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId String   @map("promo_code_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@map("promo_redemptions")
}

enum PaymentMethod {
  PAYMENT_LINK
  PAYMENT_INTENT

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  stripeReferenceId String        @unique @map("stripe_reference_id") @db.VarChar(255)
  amountCents       Int           @map("amount_cents")
  currency          String        @default("USD") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Non-unique on purpose — a failed attempt and its retry coexist. Real uniqueness ("at most
  // one SUCCEEDED per order") is the partial index in T-Shirt-constraints.sql,
  // one_successful_payment_per_order, same pattern as product_variant_combo_unique.
  @@index([orderId])
  @@map("payments")
}

model StripeEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id") @db.VarChar(255)
  type          String    @db.VarChar(100)
  payload       Json
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // No FKs — this is an idempotency log, not a domain table (DBML Note). Never query inside
  // `payload` for business logic.
  @@map("stripe_events")
}
